# Copier ce fichier en .env et adapter les valeurs

SECRET_KEY=change-moi-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Laisser DB_ENGINE=sqlite pour développer sans Postgres.
# Passer à "postgres" et renseigner les champs ci-dessous pour la prod.
DB_ENGINE=sqlite
DB_NAME=cx_ticketing
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Origines autorisées à appeler l'API (front Angular + app Expo)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:19006,http://localhost:8081
